# Crear un cliente OAuth 2.0 de tipo "Aplicacion web" en Google Cloud.
# URI de redireccion autorizada:
# http://127.0.0.1:8765/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/auth/google/callback

# Opcional. La conexión de Google se guarda cifrada en el Administrador de
# credenciales de Windows; esta clave solo firma la cookie local de Flask.
FLASK_SECRET_KEY=

# Cambiar solo si el puerto 8765 esta ocupado.
MVP_HOST=127.0.0.1
MVP_PORT=8765
